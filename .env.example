# Scoring backend — set ONE of these; without either, the heuristic scorer is used.

# TypeSafe System One API (preferred — native primitives)
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=https://api.typesafe.ai

# OpenRouter fallback (chat-completions path for typesafe/jev-latest)
OPENROUTER_API_KEY=

# Model alias
JEV_MODEL=jev-latest

# Compaction defaults
JEV_BUDGET_TOKENS=8000
JEV_STORE_DIR=.jev-compact

# Scoring backend — set ONE of these; without either, the heuristic scorer is used.

# TypeSafe System One API (preferred — native primitives; key from typesafe.ai)
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=https://api.typesafe.ai

# OpenRouter fallback — generic chat model scorer (TypeSafe models are NOT
# served on OpenRouter; this path uses any JSON-capable chat model)
OPENROUTER_API_KEY=

# Model aliases
JEV_MODEL=jev-latest
JEV_OPENROUTER_MODEL=google/gemma-3-12b-it

# Compaction defaults
JEV_BUDGET_TOKENS=8000
JEV_STORE_DIR=.jev-compact

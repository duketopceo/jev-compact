# Scoring backend — set ONE of these; without either, the heuristic scorer is used.

# TypeSafe System One API (preferred — native primitives; key from typesafe.ai)
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=https://api.typesafe.ai

# OpenRouter — TypeSafe models ARE served here via the Decisions API
# (/api/alpha/decisions); any non-TypeSafe slug uses generic chat scoring
OPENROUTER_API_KEY=

# Model aliases (~ prefix = provider's latest-release alias)
JEV_MODEL=jev-latest
JEV_OPENROUTER_MODEL=~typesafe/jev-latest

# Compaction defaults
JEV_BUDGET_TOKENS=8000
JEV_STORE_DIR=.jev-compact
